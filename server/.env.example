# Copy to server/.env (git-ignored). Everything is optional: with nothing set,
# Paywarden runs on an offline PayPal simulation with the AI features off.

# Free key from https://aistudio.google.com/apikey (don't enable billing)
GEMINI_API_KEY=
# Optional faster free provider for the chat bot (https://console.groq.com)
GROQ_API_KEY=

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox).
# Use a US sandbox business account with Advanced Credit and Debit Card Payments enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app, subscribed to PAYMENT.CAPTURE.REFUNDED
PAYPAL_WEBHOOK_ID=

# If set, /api/sessions (merchant API for external MCP clients) requires this bearer token
MERCHANT_API_TOKEN=
# 1 enables /api/guard, which trusts identity from the request body. Never on a public deploy.
PAYWARDEN_DEV=
